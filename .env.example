
# From @BotFather. Treat it like a password.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Get it with: python -m ctfbot --whoami
OWNER_ID=

# IANA timezone name used for display and for the digest schedule.
TIMEZONE=Africa/Nairobi
# Show CTFs starting within this many days.
LOOKAHEAD_DAYS=14
# Weekly digest: day (mon..sun) and 24h time in TIMEZONE.
DIGEST_DAY=mon
DIGEST_TIME=08:00
# Path to your manual events file (see events.example.toml).
EVENTS_FILE=events.toml
# SQLite file for your writeups. Created with owner-only permissions (600).
DATABASE_PATH=data/ctfbot.db
# Your category order for /log and /stats (see categories.example.toml).
CATEGORIES_FILE=categories.toml
# Nudge you after this many days without a writeup (0 = off), checked daily at NUDGE_TIME.
INACTIVITY_DAYS=3
NUDGE_TIME=18:00
# Remind you this many hours before each CTF starts (0 = off, max 168).
REMINDER_HOURS=24
